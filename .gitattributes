# 规范化行尾，避免 Windows 编辑时把 LF 改回 CRLF
* text=auto eol=lf

# 脚本必须是 LF，否则 Linux/Docker 中 shebang 会变成 "/usr/bin/env bash\r"
*.sh   text eol=lf
*.bash text eol=lf

# Dockerfile / compose / CI 配置也统一 LF，避免在 Windows 上编辑后出问题
Dockerfile*        text eol=lf
docker-compose*.yml text eol=lf
*.yml              text eol=lf
VERSION            text eol=lf
.env*              text eol=lf

# OpenWrt 源码生成物
*.bin  binary
*.img  binary
*.gz   binary
*.xz   binary
*.zst  binary
