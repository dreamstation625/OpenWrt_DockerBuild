# syntax=docker/dockerfile:1.7
###############################################################################
# OpenWrt x86_64 系统镜像
#
# 构建上下文里必须同时存在：
#   Dockerfile      本文件
#   rootfs.tar.gz   从编译产物复制过来的 openwrt-x86-64-generic-rootfs.tar.gz
#
# 一般不需要手动构建，交给 build-openwrt-docker.sh --package-image 自动准备
# 上下文并构建。
#
# 手动构建示例：
#   mkdir -p /tmp/ctx && cp docker/Dockerfile.image /tmp/ctx/Dockerfile
#   cp work/openwrt/bin/targets/x86/64/openwrt-x86-64-generic-rootfs.tar.gz \
#      /tmp/ctx/rootfs.tar.gz
#   docker build -f /tmp/ctx/Dockerfile --build-arg OPENWRT_VERSION=1.0.0 \
#      -t dreamstation625/openwrt:1.0.0 /tmp/ctx
###############################################################################
FROM scratch

ARG OPENWRT_VERSION=unknown
ARG OPENWRT_BRANCH=openwrt-25.12

LABEL org.opencontainers.image.title="openwrt" \
      org.opencontainers.image.description="OpenWrt x86_64 (${OPENWRT_BRANCH}) - LuCI + Argon + AdGuardHome + MosDNS + OpenClash + Docker" \
      org.opencontainers.image.version="${OPENWRT_VERSION}" \
      org.opencontainers.image.source="https://github.com/dreamstation625/OpenWrt_DockerBuild"

# 解包 OpenWrt rootfs（ADD 遇到 tar.gz 会自动展开）
ADD rootfs.tar.gz /

# entrypoint：把 docker/compose 传入的环境变量刷进 UCI 再交给 /sbin/init。
# 没有它，compose 的 environment 对 OpenWrt 完全无效。
# --chmod 保证可执行位（仓库 core.filemode=false，clone 下来可能不带 x）
COPY --chmod=0755 entrypoint.sh /usr/bin/openwrt-entrypoint.sh

# 备份各持久化目录的初始内容。
#
# 为什么需要：compose 用的是 bind mount（挂载到宿主机当前目录下的 data/）。
# 命名卷首次创建时 Docker 会自动把镜像内容复制进去，bind mount 不会 ——
# 宿主机目录是空的，挂上去就直接把容器内目录"盖"成空的。
# /etc/config 一空，UCI 读不到任何配置，OpenWrt 起不来也进不去 LuCI。
#
# 所以构建时先把初始内容存一份，entrypoint 启动时发现挂载目录为空就恢复。
# 目录已非空（说明用户已经在用、或之前恢复过）则不动，绝不覆盖已有配置。
#
# 显式写 /bin/sh：本镜像 FROM scratch，ADD rootfs 之后才存在 shell，
# 不指定绝对路径的话 Docker 会用默认的 /bin/sh -c，路径一致但显式更稳。
RUN ["/bin/sh", "-c", "set -eu; \
    mkdir -p /usr/share/openwrt-defaults; \
    for d in /etc/config /etc/openclash /etc/adguardhome /var/lib/adguardhome \
             /etc/mosdns /usr/share/nftables.d /root /var/log; do \
        n=$(printf '%s' \"$d\" | tr '/' '_'); \
        mkdir -p \"$d\"; \
        cp -a \"$d\" \"/usr/share/openwrt-defaults/$n\"; \
    done; \
    rm -f /usr/share/openwrt-defaults/_etc_config/.docker-env-applied"]

ENV PATH=/usr/sbin:/usr/bin:/sbin:/bin \
    HOME=/root \
    TERM=xterm \
    OPENWRT_VERSION=${OPENWRT_VERSION} \
    OPENWRT_APPLY_ENV=auto \
    OPENWRT_SEED_AUTO=1 \
    OPENWRT_HOSTNAME=OpenWrt \
    OPENWRT_TIMEZONE=CST-8 \
    OPENWRT_ZONENAME=Asia/Shanghai \
    LUCI_THEME=argon \
    LUCI_LANG=zh-cn \
    LAN_IP=192.168.31.254 \
    LAN_NETMASK=255.255.255.0 \
    LAN_GATEWAY=192.168.31.1 \
    LAN_DNS="223.5.5.5 119.29.29.29" \
    ROOT_PASSWORD=root \
    DOCKER_DATA_ROOT=/opt/docker

# OpenWrt 使用 procd 作为 init
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/openwrt-entrypoint.sh"]
CMD ["/sbin/init"]
