# 复制成 .env 后按需修改：cp .env.example .env

# ---------------- 镜像 ----------------
# 使用的镜像。tag 就是仓库根目录 VERSION 文件里的版本号
OPENWRT_IMAGE=dreamstation625/openwrt:latest
CONTAINER_NAME=openwrt

# ---------------- 持久化目录 ----------------
# 插件配置等持久化数据的存放位置（compose 用 bind mount 挂进去）
# 默认 ./data，即当前目录下的 data/
# 相对路径以 compose 文件所在目录为基准，也可以写绝对路径，例如群晖：
#   DATA_DIR=/volume1/docker/openwrt-data
#
# 备份：整个目录打包拷走即可。恢复时先停容器，解包覆盖，再启动。
# 注意目录里的文件属主是 root（容器内以 root 写入），操作请用 root/sudo。
DATA_DIR=./data

# ---------------- 网络 ----------------
# macvlan 承载网卡。宿主机执行 `ip -br link` 查真实网卡名
# 常见值：eth0 / ens18 / enp3s0 / br0
# 群晖注意：开了群晖的 Open vSwitch 时网卡名是 ovs_eth0，不是 eth0
# PVE 虚拟机注意：网卡必须用 VirtIO，SR-IOV 直通的 VF 上建不了 macvlan
LAN_PARENT_IFACE=eth0

# 容器在局域网里的地址（与固件里的 LAN 配置保持一致）
LAN_IP=192.168.31.254
LAN_SUBNET=192.168.31.0/24
LAN_GATEWAY=192.168.31.1
LAN_NETMASK=255.255.255.0
# 多个 DNS 用空格分隔
LAN_DNS=223.5.5.5 119.29.29.29

# ---------------- 部署参数（由容器内 entrypoint 刷进 UCI）----------------
# auto   只在首次启动应用一次，之后以 LuCI 里的改动为准（默认）
# always 每次启动都应用，下面写什么就是什么
# never  完全不应用，交给 LuCI
OPENWRT_APPLY_ENV=auto

OPENWRT_HOSTNAME=OpenWrt
OPENWRT_TIMEZONE=CST-8
OPENWRT_ZONENAME=Asia/Shanghai
LUCI_THEME=argon
LUCI_LANG=zh-cn
ROOT_PASSWORD=root
DOCKER_DATA_ROOT=/opt/docker
